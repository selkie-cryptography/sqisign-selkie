# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Added by cargo
/target
/Cargo.lock

# Emacs
**/*~

# Sage detritus
**/*.sage.py

# cargo-mutants
/mutants.out*/

# Fuzzer crash artifacts (triaged inputs go into fuzz/corpus/)
/crash-*

# Proptest regression files (tests are in-tree, regressions are local)
**/proptest-regressions/

# Diagnostic report written by `tests/zeroize.rs` next to where the
# test runs (worktree root by default).
/zeroize-report.json

# Allocation report written by `tests/alloc_budget.rs`.
/alloc-report.json

# Compiled C-reference cross-test oracle (built on demand by
# tools/cref_xtest/build.sh; the source is tracked, the binary is not).
/tools/cref_xtest/oracle

# LaTeX
**/*.toc

.DS_Store
app-credentials.json
dhat-heap.json
*.trace
