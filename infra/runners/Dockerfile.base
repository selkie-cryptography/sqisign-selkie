# `:base` runner image — heavy substrate (rustup + texlive +
# system tools). Slow (~10–15 min cold); rebuilt only on edits
# here, the weekly schedule, or `workflow_dispatch`.
# `Dockerfile.runtime` (`:latest`) `FROM`s this.
#
# CI builds this on a runner spawned from `:latest`. If a broken
# `:base` ships, every subsequent Machine is broken — recover via
# the laptop `ops` CLI: `deploy-runner-base` then `deploy-runners`.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# HTTPS bootstrap.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

# No `texlive-full` and no Sage here.
#
# Fly Machines enforce an 8 GB *uncompressed* image-unpack ceiling
# at the platform level (separate from per-Machine rootfs sizing).
# `texlive-full` alone is ~5 GB; a Sage 10.6 conda env adds ~4-5 GB.
# Including both pushed past the ceiling. We include the smaller
# `texlive-latex-extra` family below (~1-1.5 GB) so `latex.yml`
# can run on Fly with direct `latexmk`. Sage stays out — workflows
# that need it install at job time via conda + actions/cache.
#
# Workflows that need these:
#   - `latex.yml` -> Fly self-hosted, direct `latexmk` against the
#     `texlive-latex-extra` set below. If a tex package is missing,
#     add the specific `texlive-*` sub-package to the apt list.
#   - `sage-precompute-check` -> Fly self-hosted with conda install
#     at job time. The orchestrator sizes the runtime overlayfs via
#     `rootfs.size_gb` (see `orchestrator/src/fly.rs`) to leave room
#     for the ~4 GB conda env, and `actions/cache` keeps warm runs
#     to ~1-2 min.

# Rustup stable + nightly + clippy/rustfmt. Cross-compile targets
# stay on GitHub-hosted (Fly is x86_64-linux only).
#
# IMPORTANT: do NOT bake more toolchains or components here without
# verifying the resulting image stays under Fly's 8 GB uncompressed
# unpack ceiling. A previous attempt to add `llvm-tools-preview` on
# stable + a `1.81.0` MSRV toolchain pushed past the limit and every
# spawned Machine failed with "Not enough space to unpack image".
# Per-job `dtolnay/rust-toolchain` steps install extra components at
# job time (~30-60s per job); pay that cost rather than break the
# image.
#
# Pre-create the `runner` user so RUSTUP_HOME / CARGO_HOME can be
# chowned. Job-time `dtolnay/rust-toolchain` invocations refresh
# rustup and need write access to RUSTUP_HOME.
RUN useradd -m -s /bin/bash runner \
  && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path \
  && rustup toolchain install nightly --profile minimal \
  && rustup component add rustfmt clippy --toolchain nightly \
  && chown -R runner:runner "$RUSTUP_HOME" "$CARGO_HOME"

# Pre-install `gungraun-runner` so `profile.yml`'s `Install
# gungraun-runner` step becomes a fast no-op (~1 s "package already
# installed") instead of an ~8 min from-source rebuild on every matrix
# shard.  Cost is paid once at image-build time; the workflow's
# `cargo install gungraun-runner --version $ver --locked` then short-
# circuits when the baked binary satisfies the exact version cargo
# resolves from `gungraun = "0.19"` in `Cargo.toml`.
#
# The version requirement here tracks `Cargo.toml`, not a specific
# patch: each base-image build picks up the latest `0.19.x` from
# crates.io.  Bump this string when the workspace bumps `gungraun`'s
# major.minor (e.g. `0.19` -> `0.20`); the workflow's pinned install
# falls back to a from-source build in the gap.
#
# Sized ~20 MB binary plus its registry footprint; well under the
# 8 GB unpack ceiling that the warning above tracks.
RUN cargo install gungraun-runner --version '^0.19' --locked \
  && chown -R runner:runner "$CARGO_HOME"

# System tools + TeX Live (latex-extra family, ~1-1.5 GB).
#
# `libclang-dev` is needed by the `crabgrind` build script (uses
# `bindgen` to generate Valgrind FFI). Without it, every `cargo
# build` of the main crate panics with "Unable to find libclang".
# Previously came in transitively via Sage's conda env; pinned
# explicitly now that Sage is no longer in the image.
#
# `mold` is wired into `.cargo/config.toml` as the linker for
# `x86_64-unknown-linux-gnu`. Cuts cargo link time ~15-30%.
#
# `texlive-*` + `latexmk` + `biber` power `latex.yml` on Fly
# self-hosted (replacing the previous `xu-cheng/latex-action`
# Docker-action path which required a Docker daemon we don't run).
#
# `unzip` is needed for the AWS CLI v2 install below; the bundled
# installer ships as a zip and the apt `awscli` package no longer
# exists on noble (see comment on that RUN step).
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
      biber \
      build-essential \
      cmake \
      docker.io \
      git \
      jq \
      latexmk \
      libclang-dev \
      libicu-dev \
      libssl-dev \
      lmodern \
      mold \
      pkg-config \
      python3 \
      python3-pip \
      sudo \
      texlive-bibtex-extra \
      texlive-fonts-extra \
      texlive-fonts-recommended \
      texlive-latex-extra \
      texlive-plain-generic \
      texlive-science \
      unzip \
      valgrind \
      zstd \
  && rm -rf /var/lib/apt/lists/*

# AWS CLI v2 (bundled binary distribution).
#
# Ubuntu 24.04 noble removed the `awscli` apt package — v1 (Python-
# based) is upstream-EOL and AWS distributes v2 via this installer
# instead. Used by `.github/scripts/ci-scratch.rs` for the Tigris
# S3-compatible scratch path; the v1→v2 surface diff doesn't affect
# the `aws s3 cp` / `aws s3 ls` calls that script makes.
RUN curl --proto '=https' --tlsv1.2 -fsSL \
      "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
      -o /tmp/awscliv2.zip \
  && unzip -q /tmp/awscliv2.zip -d /tmp \
  && /tmp/aws/install \
  && rm -rf /tmp/awscliv2.zip /tmp/aws

# GitHub CLI (`gh`) — used by `.github/scripts/ci-signal.rs`
# (commits.json refresh via `gh api`) and `fuzz.yml`'s "Open PR on
# crash" step (`gh pr create` + `gh auth setup-git`). Install via
# GitHub's official apt repository (recommended path):
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md#recommended-official
#
# `wget`-with-sanity-check from the upstream instructions is
# replaced with `curl` (already in the image) since apt's own
# signature verification against the keyring is what actually
# guards integrity for ongoing package fetches.
RUN curl --proto '=https' --tlsv1.2 -fsSL \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# Passwordless sudo for the `runner` user. Lets workflows apt-install
# tools on demand instead of rolling this image every time something
# new is needed. The Machine is ephemeral and per-job, and workflows
# already run with repo-secret access, so this isn't a meaningful
# threat-model change. Bake heavy/slow tools (TeX, Sage, Rust) in
# above; install lightweight per-workflow needs at job time.
RUN echo 'runner ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/runner \
  && chmod 0440 /etc/sudoers.d/runner
