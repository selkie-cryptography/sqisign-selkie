# `:latest` runner image — thin layer over `:base` adding the
# actions-runner binary + entrypoint. Fast (~30s) since `FROM`
# pulls the pre-pushed `:base`. Build `:base` (Dockerfile.base)
# first if it doesn't exist yet.
#
# `BASE_IMAGE` is overridable via `--build-arg` so CI can pin to
# the immutable digest the `:base` job just pushed (e.g.,
# `registry.fly.io/sqisign-infra-runners@sha256:...`). This avoids
# a race where the runtime build resolves `:base` to a stale
# digest from Depot's BuildKit cache instead of the freshly-
# pushed manifest. The default uses the named tag so `ops` and
# manual `flyctl deploy` still work.

ARG BASE_IMAGE=registry.fly.io/sqisign-infra-runners:base
FROM ${BASE_IMAGE}

# GitHub refuses runners more than a few releases behind ("Runner
# version vX is deprecated and cannot receive messages"); a pinned
# 2.334.0 took the fleet down from 2026-08-10 to 2026-09-07. Empty
# resolves the current release at build time, so the weekly rebuild
# in `infra-ci.yml` keeps the fleet accepted. Pass a version to
# override.
ARG RUNNER_VERSION=

RUN mkdir -p /home/runner/actions-runner \
  && chown runner:runner /home/runner/actions-runner

WORKDIR /home/runner/actions-runner

USER runner
RUN set -eu; \
  v="${RUNNER_VERSION}"; \
  if [ -z "$v" ]; then \
    v=$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest \
        | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p'); \
  fi; \
  echo "actions-runner ${v}"; \
  curl -fL -o runner.tar.gz \
      "https://github.com/actions/runner/releases/download/v${v}/actions-runner-linux-x64-${v}.tar.gz" \
  && tar xzf runner.tar.gz \
  && rm runner.tar.gz
USER root
RUN ./bin/installdependencies.sh

# Entrypoint reads JITCONFIG and execs one runner registration.
# Machine is spawned with auto_destroy=true → exit destroys the VM.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER runner
ENTRYPOINT ["/entrypoint.sh"]
