{
  "algorithm": "SQIsign_248",
  "schema": "sqisign_verify_schema.json",
  "numberOfTests": 49,
  "header": [
    "SQIsign_248: f=248, p = 5*2^248 - 1 (NIST security level I).",
    "Negative and vulnerability test vectors for SQIsign_248 verification.",
    "Format: C2SP/wycheproof JSON. Invalid vectors independently generated by perturbation.",
    "Valid vectors from PQCsignKAT_353_SQIsign_lvl1.rsp (C ref commit 91e9e464).",
    "Spec version: SQIsign v2.0.1 (2025-07-07).",
    "Round 2: exponent overflow, non-canonical Fp, special j-invariants, degenerate matrix/challenge, field splicing.",
    "Round 3: singular curves, starting curve E_0, scalar/challenge overflow.",
    "Round 4: malformed public keys (all-zero, all-FF, singular, non-canonical).",
    "Round 5: panic regression vectors for hint overflow, exponent underflow, and fuzz crash inputs."
  ],
  "notes": {
    "Normal": "Unmodified KAT vector, expected to verify.",
    "WrongMessage": "Message differs from the one that was signed.",
    "EmptyMessage": "Empty message substituted for a non-empty signed message.",
    "MessageExtended": "One extra byte appended to the original message.",
    "MessageTruncated": "Last byte of the original message removed.",
    "WrongPublicKey": "Signature verified against a different public key.",
    "BitFlipEAux": "Single bit flipped in the E_aux field (bytes 0..64).",
    "BitFlipNBt": "Single bit flipped in n_bt (byte 64).",
    "BitFlipRRsp": "Single bit flipped in r_rsp (byte 65).",
    "BitFlipMChl": "Single bit flipped in M_chl (bytes 66..130).",
    "BitFlipChl": "Single bit flipped in the challenge (bytes 130..146).",
    "BitFlipHintAux": "Single bit flipped in hint_aux (byte 146).",
    "BitFlipHintChl": "Single bit flipped in hint_chl (byte 147).",
    "AllZero": "All-zero signature bytes.",
    "AllOnes": "All-0xFF signature bytes (n_bt and r_rsp exceed bound).",
    "ExponentOverflow": {
      "bugType": "BASIC",
      "description": "n_bt + r_rsp > e_rsp, causing e_rsp_prime underflow. Must be rejected, not wrapped."
    },
    "NonCanonicalFp": {
      "bugType": "BASIC",
      "description": "Field element >= p in E_aux. A strict implementation rejects; a permissive one reduces mod p and gets the wrong curve. Both must fail verification.",
      "links": [
        "https://github.com/C2SP/wycheproof/blob/master/doc/types.md"
      ]
    },
    "SpecialJInvariant": {
      "bugType": "EDGE_CASE",
      "description": "E_aux has j-invariant 0 or 1728 (extra automorphisms). May cause unexpected behavior in isogeny computation."
    },
    "DegenerateMatrix": {
      "bugType": "FUNCTIONALITY",
      "description": "M_chl is zero or identity, producing a degenerate or trivial kernel."
    },
    "ZeroChallenge": {
      "bugType": "FUNCTIONALITY",
      "description": "Challenge hash is all-zero, a degenerate Fiat-Shamir output."
    },
    "SplicedField": {
      "bugType": "FUNCTIONALITY",
      "description": "One field of the signature replaced with the corresponding field from a different valid signature. Tests that fields are cryptographically bound to each other."
    },
    "SingularCurve": {
      "bugType": "EDGE_CASE",
      "description": "E_aux with A = +/-2, making the Montgomery curve singular (discriminant zero, j undefined). Must not crash."
    },
    "StartingCurve": {
      "bugType": "EDGE_CASE",
      "description": "E_aux = E_0 (the starting curve with A=6). An honest signature never has E_aux = E_0; this tests whether verification rejects or handles it gracefully."
    },
    "ScalarOverflow": {
      "bugType": "BASIC",
      "description": "Matrix entry exceeds the torsion bound 2^e_rsp. Must not wrap silently."
    },
    "ChallengeOverflow": {
      "bugType": "BASIC",
      "description": "Challenge has high bits set beyond e_chl=122. A strict implementation masks or rejects."
    },
    "MalformedPk": {
      "bugType": "BASIC",
      "description": "Public key with invalid or degenerate encoding. Must be rejected at parse time or cause verification to fail."
    },
    "HintOverflow": {
      "bugType": "BASIC",
      "description": "Hint byte causes x-coordinate search loop counter to overflow (u8 wrapping). Prior to fix, caused panic in debug mode. Must be rejected gracefully.",
      "links": []
    }
  },
